# =============================================================================
# Kurir — Environment Configuration
# =============================================================================
# For self-hosted deployments, you only need to set KURIR_DOMAIN.
# All secrets auto-generate on first boot if not provided.
# =============================================================================

# --- Required for production ---
# Your domain (e.g., mail.example.com). Derives NEXTAUTH_URL, WEBAUTHN_RP_ID.
# KURIR_DOMAIN="mail.example.com"

# --- Optional: admin email (used for VAPID contact / Let's Encrypt) ---
# KURIR_ADMIN_EMAIL="admin@example.com"

# --- Database ---
# Default: postgresql://kurir:kurir@localhost:5432/kurir
# DATABASE_URL="postgresql://kurir:kurir@localhost:5432/kurir"

# --- Secrets (auto-generated on first boot if missing) ---
# AUTH_SECRET=""
# ENCRYPTION_KEY=""
# ENCRYPTION_SALT="kurir-salt"

# --- VAPID keys for push notifications (auto-generated on first boot) ---
# Both keys are read at runtime. The public key is served to browsers via
# /api/push/vapid-public-key, so no rebuild is needed when it changes. For
# production, set both to a persistent, matching keypair — if they change
# between deploys, existing push subscriptions break.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# --- Redis (optional, defaults to localhost:6379) ---
# REDIS_URL="redis://localhost:6379"

# --- OAuth providers (optional, for Microsoft/Google IMAP OAuth) ---
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- WebAuthn overrides (derived from KURIR_DOMAIN by default) ---
# WEBAUTHN_RP_NAME="Kurir"
# WEBAUTHN_RP_ID="mail.example.com"
# A second browser origin for the same instance, comma-separated.
# The proxy must send X-Forwarded-Host, and that host must be listed here
# or login redirects stay on NEXTAUTH_URL. Passkeys accept these origins.
# The relying party id still has to be a parent of every hostname
# (example.com covers mail.example.com and mcp.example.com).
# KURIR_EXTRA_ORIGINS="https://mail.example.com"

# --- iOS push relay (optional, for self-hosted instances) ---
# APNs relay for the App Store iOS app. Self-hosted servers cannot sign
# APNs pushes themselves (the key belongs to the app maintainer); point
# this at the hosted relay and iOS push works. Own APNS_* keys (maintainer
# only) always take precedence over the relay.
# PUSH_RELAY_URL="https://kurir-notify.arvidson.io"
