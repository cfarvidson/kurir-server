---
import { APP_STORE_IOS } from "../lib/store";

const base = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden px-6 pb-16 pt-14 md:pb-24 md:pt-20">
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 80% 60% at 50% 0%, #fed7aa40 0%, transparent 70%)"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-landing">
    <div class="reveal mx-auto max-w-3xl text-center">
      <img
        src={`${base}mascot.png`}
        alt=""
        width="96"
        height="96"
        class="mx-auto mb-6 rounded-2xl"
      />
      <h1
        class="text-balance text-4xl font-bold leading-[1.1] tracking-tight text-ink md:text-[3.5rem]"
        id="intro"
      >
        <strong class="text-accent">HEY's workflow.</strong>
        Your server.
      </h1>
      <p
        class="mx-auto mt-6 max-w-xl text-[1.0625rem] leading-[1.8] text-ink-light"
      >
        New senders are screened. Your Imbox is only people you've approved.
        Newsletters live in The Feed. Receipts go to Paper Trail. You host it.
      </p>
      <div
        class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-3"
      >
        <a
          href={APP_STORE_IOS}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-accent"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
            ></path>
          </svg>
          Get the iPhone app
        </a>
        <a
          href={`${base}docs/getting-started`}
          class="inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink hover:bg-surface-50"
        >
          Self-host it
        </a>
      </div>
      <p class="mt-4 text-sm text-ink-muted">
        The app talks to your Kurir server. Buying it funds the rest.
      </p>
    </div>

    <figure class="reveal reveal-delay-1 mx-auto mt-14 max-w-4xl md:mt-16">
      <img
        src={`${base}screenshots/app.png`}
        alt="Kurir email client showing the sidebar with Imbox, Screener, Feed, and Paper Trail"
        class="rounded-2xl border border-surface-200 shadow-2xl shadow-accent/5"
        width="1280"
        height="800"
        loading="eager"
      />
    </figure>
  </div>
</section>
