---
const endpoint = "https://<your-domain>/mcp";
const steps = [
  "Add the endpoint as a custom connector in Claude.",
  "Sign in with the same passkey you already use.",
  "Approve access. Revoke it later under Settings.",
];
---

<section class="bg-surface-50 px-6 py-24 md:py-32" id="mcp">
  <div class="mx-auto max-w-landing">
    <div class="reveal grid items-end gap-6 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-7">
        <p
          class="text-xs font-semibold uppercase tracking-[0.15em] text-accent"
        >
          MCP
        </p>
        <h2
          class="mt-3 text-3xl font-bold leading-[1.15] tracking-tight text-balance text-ink md:text-[2.75rem]"
        >
          Ask Claude about your mail.
        </h2>
      </div>
      <p
        class="reveal reveal-delay-1 text-lg leading-relaxed text-ink-light md:col-span-5"
      >
        Search, triage, screen senders, and change your settings from Claude.
        Your mail stays on your server. Sending and other destructive actions
        ask for a confirmation first.
      </p>
    </div>

    <div
      class="reveal reveal-delay-2 mt-14 grid overflow-hidden rounded-2xl border border-surface-200 bg-white md:grid-cols-12"
    >
      <ol class="divide-y divide-surface-200 md:col-span-7">
        {
          steps.map((step, i) => (
            <li class="flex gap-5 px-8 py-6 md:px-10 md:py-7">
              <span
                class="font-display text-2xl leading-none text-accent"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="pt-0.5 text-[1.0625rem] leading-relaxed text-ink">
                {step}
              </p>
            </li>
          ))
        }
      </ol>

      <div
        class="flex flex-col justify-center border-t border-surface-200 bg-ink px-8 py-10 md:col-span-5 md:border-l md:border-t-0 md:px-10"
      >
        <p
          class="text-xs font-medium uppercase tracking-[0.12em] text-white/65"
        >
          Custom connector
        </p>
        <div
          class="mt-3 overflow-hidden rounded-xl border border-white/10 bg-white/5"
        >
          <div
            class="flex items-center justify-between border-b border-white/10 px-3 py-2"
          >
            <span class="font-mono text-[11px] text-white/40">endpoint</span>
            <button
              class="flex items-center gap-1.5 rounded-md px-2 py-0.5 text-[11px] font-medium text-white/50 transition-colors hover:bg-white/10 hover:text-white"
              data-cmd={endpoint}
              type="button"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"
                ></path>
              </svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <p class="overflow-x-auto px-3 py-3.5 font-mono text-sm text-white">
            {endpoint}
          </p>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-white/70">
          Claude.ai, Claude Desktop, and Claude Code. Revoke under Settings
          &rarr; Connected apps.
        </p>
      </div>
    </div>
  </div>
</section>
